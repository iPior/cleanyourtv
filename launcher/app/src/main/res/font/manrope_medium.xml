<?xml version="1.0" encoding="utf-8"?>
<!-- Manrope at weight 500, for Feature. Cut down to Western European letters, digits and punctuation, and to
     weights 500 to 800; Feature falls back to Outfit in locales whose fonts.xml names a system family. -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <font
        android:font="@font/manrope"
        android:fontStyle="normal"
        android:fontWeight="500"
        android:fontVariationSettings="'wght' 500"
        tools:targetApi="28" />
</font-family>
